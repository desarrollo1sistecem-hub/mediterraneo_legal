<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_action_create_wizard_form" model="ir.ui.view">
        <field name="name">legal.action.create.wizard.form</field>
        <field name="model">legal.action.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear tarea legal">
                <group>
                    <field name="agreement_id" readonly="1"/>
                    <field name="project_id"/>
                    <field name="user_id"/>
                    <field name="legal_task_type_id"/>
                </group>
                <group>
                    <field name="description"/>
                </group>
                <footer>
                    <button string="Crear tarea"
                            type="object"
                            name="action_create"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
