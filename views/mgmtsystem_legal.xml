<!--    vista original sin modificar-->
    <record id="view_mgmtsystem_action_form_inherit_legal" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.inherit.legal</field>
        <field name="model">mgmtsystem.action</field>
        <!-- Heredamos el formulario original del módulo mgmtsystem_action -->
        <field name="inherit_id" ref="mgmtsystem_action.view_mgmtsystem_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Información Legal">
                    <field name="project_id"/>
                    <field name="agreement_id"/>
                    <field name="is_legal"/>
                    <field name="legal_task_type_id"/>
                    <field name="partner_id"/>
                </group>
            </xpath>
        </field>
    </record>
