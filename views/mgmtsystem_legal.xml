<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="action_mgmtsystem_legal_actions" model="ir.actions.act_window">
        <field name="name">Tareas Legales</field>
        <field name="res_model">mgmtsystem.action</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_legal', '=', True)]</field>
        <field name="context">{'default_is_legal': True}</field>
    </record>

<!--    <record id="action_legal_projects" model="ir.actions.act_window">-->
<!--        <field name="name">Proyectos (Área Legal)</field>-->
<!--        <field name="res_model">project.project</field>-->

<!--        <field name="view_mode">tree,form</field>-->
<!--    </record>-->
    <record id="action_legal_projects" model="ir.actions.act_window">
        <field name="name">Proyectos (Área Legal)</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('project.view_project')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mediterraneo_legal.view_project_legal_contracts_only_form')})]"/>
    </record>
<!--    menu raiz de legal-->
    <menuitem id="menu_legal_root"
              name="Legal"
              sequence="60"
              groups="base.group_user"
              web_icon="mediterraneo_legal,static/description/icon.png"/>

<!--    menu de tareas de legal-->
    <menuitem id="menu_legal_actions"
              name="Tablero de Tareas"
              parent="menu_legal_root"
              action="action_mgmtsystem_legal_actions"
              sequence="20"/>

<!--        menu de proyecto/obras de legal-->
    <menuitem id="menu_legal_projects"
              name="Obras (Legal)"
              parent="menu_legal_root"
              action="project.open_view_project_all"
              sequence="20"/>
    <menuitem id="menu_legal_projects"
              name="Proyectos (Legal)"
              parent="menu_legal_root"
              action="action_legal_projects"
              sequence="10"/>


    <!-- accion para ver y crear acuerdos desde el modulo Legal -->
    <record id="action_legal_agreements" model="ir.actions.act_window">
        <field name="name">Contratos legales</field>
        <field name="res_model">agreement</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem id="menu_legal_agreements"
              name="Contratos (Legal)"
              parent="menu_legal_root"
              action="action_legal_agreements"
              sequence="30"/>
