<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_inherit_legal" model="ir.ui.view">
        <field name="name">project.project.form.inherit.legal</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Área Legal">
                    <group>
                        <field name="dms_directory_legal_id"/>
                    </group>

                    <group string="Contratos / Acuerdos">
                        <field name="agreement_ids">
                            <tree>
                                <field name="name"/>
                                <field name="legal_category"/>
                                <field name="partner_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
<!--                            agregando el nuevo tipo de acuerdo-->
                                <field name="agreement_type_id" string="Tipo de acuerdo"/>
                            </tree>
                        </field>
                    </group>

<!--                    <group string="Tareas legales">-->
<!--                        <field name="legal_action_ids">-->
<!--                            <tree>-->
<!--                                <field name="name"/>-->
<!--                                <field name="user_id"/>-->
<!--                                <field name="date_deadline"/>-->
<!--                                <field name="stage_id"/>-->
<!--                            </tree>-->
<!--                        </field>-->
<!--                    </group>-->
                </page>
            </xpath>

        </field>
    </record>
<!--    vista de todos lo contratos o acuerdos que tiene ese proyecto-->
    <record id="view_project_legal_contracts_only_form" model="ir.ui.view">
        <field name="name">project.project.legal.contracts.only.form</field>
        <field name="model">project.project</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Contratos de la Obra">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Nombre de la Obra"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="partner_id" readonly="1" string="Cliente"/>
                    </group>
                    <separator string="Contratos / Acuerdos Legales"/>
                    <field name="agreement_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="name" string="Referencia"/>
                            <field name="legal_category"/>
                            <field name="partner_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="agreement_type_id"  string="Tipo de acuerdo"/>
                            <button name="get_formview_action" string="Ver detalles" type="object" icon="fa-external-link"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
